# Copy this file to .env and fill in values before running docker-compose

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_DB=docuvault
POSTGRES_USER=docuvault
POSTGRES_PASSWORD=change_me_strong_password

# ── Contabo Object Storage (S3-compatible) ─────────────────────────────────────
S3_ACCESS_KEY=your_contabo_access_key
S3_SECRET_KEY=your_contabo_secret_key
S3_BUCKET=your_bucket_name

# ── WAHA (WhatsApp HTTP API) ───────────────────────────────────────────────────
WAHA_API_KEY=change_me_waha_secret

# ── Authentication (JWT) — REQUIRED ───────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_64_char_string

# ── Frontend CORS ──────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://docs.onctionenergy.com,http://localhost:5173

# ── Monitoring ─────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me_grafana_password

# ── Grafana email alerts (optional — leave GF_SMTP_ENABLED=false to skip) ──────
GF_SMTP_ENABLED=false
GF_SMTP_HOST=smtp.gmail.com:465
GF_SMTP_USER=your_email@gmail.com
GF_SMTP_PASSWORD=your_gmail_app_password
GF_SMTP_FROM_ADDRESS=your_email@gmail.com
