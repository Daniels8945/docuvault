# Copy this file to .env and fill in values before running docker-compose

# PostgreSQL
POSTGRES_DB=docuvault
POSTGRES_USER=docuvault
POSTGRES_PASSWORD=change_me_strong_password

# Contabo Object Storage (S3-compatible)
# Endpoint is fixed: eu2.contabostorage.com — set in docker-compose.yml
S3_ACCESS_KEY=your_contabo_access_key
S3_SECRET_KEY=your_contabo_secret_key
S3_BUCKET=your_bucket_name

# WAHA (WhatsApp HTTP API)
WAHA_API_KEY=change_me_waha_secret
