{
  "uid": "docuvault-overview",
  "title": "DocuVault — App Overview",
  "tags": ["docuvault"],
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "timezone": "browser",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1, "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "title": "Total Documents Uploaded",
      "type": "stat",
      "targets": [{ "expr": "sum(docuvault_documents_uploaded_total)", "legendFormat": "" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "blue", "value": 0 }] } } }
    },
    {
      "id": 2, "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "title": "Uploads — Last 1 h",
      "type": "stat",
      "targets": [{ "expr": "sum(increase(docuvault_documents_uploaded_total[1h]))", "legendFormat": "" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": 0 }] } } }
    },
    {
      "id": 3, "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "title": "Upload Failures — Last 1 h",
      "type": "stat",
      "targets": [{ "expr": "sum(increase(docuvault_upload_failures_total[1h]))", "legendFormat": "" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 1 }] } } }
    },
    {
      "id": 4, "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "title": "HTTP Error Rate (5xx) — Last 5 m",
      "type": "stat",
      "targets": [{ "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m]))", "legendFormat": "" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "orange", "value": 0.01 }, { "color": "red", "value": 0.1 }] } } }
    },
    {
      "id": 5, "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "title": "p95 API Response Time",
      "type": "stat",
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "orange", "value": 1 }, { "color": "red", "value": 3 }] } } }
    },
    {
      "id": 6, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "title": "Request Rate by Status",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(http_requests_total{status=~\"2..\"}[1m]))", "legendFormat": "2xx (success)" },
        { "expr": "sum(rate(http_requests_total{status=~\"4..\"}[1m]))", "legendFormat": "4xx (client error)" },
        { "expr": "sum(rate(http_requests_total{status=~\"5..\"}[1m]))", "legendFormat": "5xx (server error)" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "2xx (success)" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "4xx (client error)" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "5xx (server error)" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      }
    },
    {
      "id": 7, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "title": "Document Upload Rate (by source)",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(docuvault_documents_uploaded_total{source=\"manual\"}[5m])", "legendFormat": "Manual uploads" },
        { "expr": "rate(docuvault_documents_uploaded_total{source=\"whatsapp\"}[5m])", "legendFormat": "WhatsApp saves" }
      ],
      "fieldConfig": { "defaults": { "unit": "/ min", "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 8, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "title": "S3 Upload Duration (p50 / p95)",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(docuvault_s3_operation_seconds_bucket{operation=\"upload\"}[5m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(docuvault_s3_operation_seconds_bucket{operation=\"upload\"}[5m])) by (le))", "legendFormat": "p95" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 9, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "title": "Top Endpoints by Request Count",
      "type": "timeseries",
      "targets": [
        { "expr": "topk(5, sum by (handler) (rate(http_requests_total[5m])))", "legendFormat": "{{handler}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    }
  ]
}
